<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kapook New Homepage Layout</title>
  <style>
    :root {
      --green: #10a63a;
      --green-dark: #08752a;
      --green-soft: #e9f8ee;
      --ink: #1f2937;
      --muted: #667085;
      --line: #e5e7eb;
      --bg: #f5f7f8;
      --white: #ffffff;
      --yellow: #fff6d7;
      --orange: #fff0e3;
      --pink: #ffeaf2;
      --blue: #e9f2ff;
      --purple: #f2eaff;
      --teal: #e7f8f5;
      --red: #ffecec;
      --radius-xl: 24px;
      --radius-lg: 18px;
      --radius-md: 14px;
      --shadow: 0 10px 28px rgba(16, 24, 40, 0.08);
      --max: 1180px;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--ink);
    }

    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; }

    .container {
      width: min(var(--max), calc(100% - 32px));
      margin: 0 auto;
    }

    .utility-bar {
      background: var(--green-dark);
      color: #fff;
      font-size: 13px;
    }

    .utility-inner {
      min-height: 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .ticker {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }

    .ticker::-webkit-scrollbar { display: none; }
    .ticker strong { opacity: 0.9; }
    .ticker a { opacity: 0.95; }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--white);
      border-bottom: 1px solid var(--line);
    }

    .header-main {
      min-height: 72px;
      display: grid;
      grid-template-columns: 170px 1fr auto;
      align-items: center;
      gap: 18px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 30px;
      font-weight: 900;
      letter-spacing: -1.2px;
      color: var(--green);
    }

    .logo-mark {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: linear-gradient(135deg, var(--green), #84dc67);
      color: #fff;
      box-shadow: 0 8px 18px rgba(16, 166, 58, 0.25);
    }

    .search {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f2f4f7;
      border: 1px solid #eaecf0;
      border-radius: 999px;
      padding: 5px 6px 5px 18px;
    }

    .search input {
      flex: 1;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: 15px;
      min-width: 80px;
    }

    .btn {
      border: 0;
      background: var(--green);
      color: #fff;
      border-radius: 999px;
      padding: 10px 16px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      font-weight: 800;
      white-space: nowrap;
    }

    .points-pill {
      background: var(--green-soft);
      color: var(--green-dark);
      border: 1px solid #bfeac9;
      padding: 9px 12px;
      border-radius: 999px;
    }

    .main-nav {
      border-top: 1px solid var(--line);
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }

    .main-nav::-webkit-scrollbar { display: none; }

    .main-nav .container {
      min-height: 46px;
      display: flex;
      align-items: center;
      gap: 22px;
      font-size: 14px;
      font-weight: 900;
      color: #344054;
    }

    .main-nav a.active { color: var(--green); }

    .ad {
      border-radius: var(--radius-lg);
      border: 1px dashed #d69a20;
      background: #fff8e6;
      color: #8a5a00;
      display: grid;
      place-items: center;
      text-align: center;
      font-weight: 900;
      font-size: 13px;
    }

    .leaderboard-ad {
      min-height: 96px;
      margin: 18px 0;
    }

    .square-ad {
      aspect-ratio: 1 / 1;
      min-height: 250px;
      padding: 16px;
    }

    .mobile-ad { min-height: 64px; margin: 14px 0; display: none; }

    .hero-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr) 300px;
      gap: 18px;
      align-items: stretch;
    }

    .card,
    .panel,
    .hero-card,
    .color-link,
    .story-card,
    .campaign-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .hero-card {
      min-height: 420px;
      display: flex;
      flex-direction: column;
    }

    .hero-art {
      flex: 1;
      min-height: 245px;
      background:
        radial-gradient(circle at 15% 20%, rgba(255,255,255,0.55), transparent 28%),
        linear-gradient(135deg, #067328, #10a63a 60%, #86dc65);
      position: relative;
    }

    .hero-art::after {
      content: "Main Feature";
      position: absolute;
      left: 20px;
      bottom: 18px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255,255,255,0.92);
      color: var(--green-dark);
      font-size: 13px;
      font-weight: 900;
    }

    .hero-body { padding: 20px; }

    .eyebrow {
      display: inline-flex;
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--green-soft);
      color: var(--green-dark);
      font-size: 12px;
      font-weight: 900;
      margin-bottom: 10px;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1 {
      font-size: clamp(30px, 3.2vw, 44px);
      line-height: 1.05;
      letter-spacing: -1.4px;
      margin-bottom: 10px;
    }

    .muted { color: var(--muted); line-height: 1.55; }

    .top-panel { padding: 18px; }

    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .section-title h2 { margin: 0; font-size: 22px; letter-spacing: -0.5px; }
    .section-title a { color: var(--green); font-size: 13px; font-weight: 900; }

    .story-list { display: grid; gap: 12px; }

    .story-row {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--line);
    }

    .story-row:last-child { border-bottom: 0; padding-bottom: 0; }

    .thumb {
      min-height: 66px;
      border-radius: 13px;
      background: linear-gradient(135deg, #d9f6df, #b7eac4);
    }

    .story-row h3 { font-size: 15px; line-height: 1.32; margin-bottom: 6px; }
    .meta { color: var(--muted); font-size: 12px; }

    .right-rail {
      display: grid;
      gap: 18px;
    }

    .member-box {
      padding: 18px;
      background: linear-gradient(180deg, #ffffff, #f0fbf3);
    }

    .member-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 14px 0;
    }

    .stat {
      border: 1px solid #d7f0dc;
      border-radius: 14px;
      padding: 12px;
      background: #fff;
    }

    .stat strong { display: block; color: var(--green-dark); font-size: 22px; }
    .stat span { color: var(--muted); font-size: 12px; }

    .quick-link-section {
      margin: 22px 0 28px;
    }

    .quick-title {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .quick-title h2 { margin: 0; font-size: 24px; }

    .color-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 12px;
    }

    .color-link {
      min-height: 112px;
      box-shadow: none;
      border: 1px solid rgba(16, 24, 40, 0.06);
      padding: 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .color-link:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
    }

    .color-link strong { font-size: 16px; line-height: 1.2; }
    .color-link span { color: #475467; font-size: 12px; line-height: 1.3; }
    .color-link.news { background: var(--blue); }
    .color-link.lottery { background: var(--yellow); }
    .color-link.horoscope { background: var(--purple); }
    .color-link.entertainment { background: var(--pink); }
    .color-link.sports { background: var(--teal); }
    .color-link.food { background: #fff4e8; }
    .color-link.travel { background: #eaf7ff; }
    .color-link.shopping { background: #ecfff2; }

    .section { margin: 28px 0; }

    .module {
      background: var(--white);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow);
      padding: 20px;
    }

    .module-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 16px;
      border-left: 6px solid var(--green);
      padding-left: 12px;
    }

    .module-header h2 { margin: 0; font-size: 24px; letter-spacing: -0.6px; }
    .module-header a { color: var(--green); font-size: 13px; font-weight: 900; }

    .module-header.entertainment { border-color: #f06292; }
    .module-header.horoscope { border-color: #8b5cf6; }
    .module-header.lifestyle { border-color: #f59e0b; }
    .module-header.sports { border-color: #14b8a6; }
    .module-header.shopping { border-color: #22c55e; }
    .module-header.video { border-color: #ef4444; }

    .content-with-ad {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 18px;
      align-items: start;
    }

    .card-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .story-card {
      box-shadow: none;
      border: 1px solid var(--line);
    }

    .story-card .thumb {
      min-height: 132px;
      border-radius: 0;
    }

    .story-card-body { padding: 14px; }
    .story-card h3 { font-size: 16px; line-height: 1.34; margin-bottom: 8px; }

    .feature-plus-list {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
      gap: 16px;
    }

    .big-feature {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: #fff;
    }

    .big-feature .thumb { min-height: 220px; border-radius: 0; }
    .big-feature-body { padding: 16px; }
    .big-feature h3 { font-size: 22px; line-height: 1.25; margin-bottom: 8px; }

    .tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      margin-bottom: 16px;
      scrollbar-width: none;
    }

    .tabs::-webkit-scrollbar { display: none; }

    .tab {
      border: 1px solid var(--line);
      background: #fff;
      color: #344054;
      border-radius: 999px;
      padding: 9px 13px;
      font-weight: 900;
      font-size: 13px;
      white-space: nowrap;
    }

    .tab.active { background: var(--green); border-color: var(--green); color: #fff; }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .tool-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .tool-box {
      border-radius: var(--radius-lg);
      border: 1px solid var(--line);
      padding: 18px;
      background: #fff;
    }

    .tool-box.lottery { background: var(--yellow); }
    .tool-box.horoscope { background: var(--purple); }
    .tool-value {
      font-size: 34px;
      font-weight: 900;
      color: var(--green-dark);
      letter-spacing: -1px;
    }

    .shopping-row {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
    }

    .shop-card {
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: #fff;
      overflow: hidden;
    }

    .shop-card .thumb {
      min-height: 110px;
      border-radius: 0;
      background: linear-gradient(135deg, #fff1c2, #d8f7d5);
    }

    .shop-card-body { padding: 12px; font-weight: 900; line-height: 1.35; font-size: 14px; }

    .campaign-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .campaign-card {
      box-shadow: none;
      border: 1px solid var(--line);
      padding: 18px;
    }

    .footer {
      margin-top: 38px;
      padding: 34px 0 92px;
      background: #0f172a;
      color: #d0d5dd;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr repeat(3, 1fr);
      gap: 24px;
    }

    .footer h3, .footer h4 { color: #fff; }
    .footer a { display: block; margin: 8px 0; color: #d0d5dd; font-size: 14px; }

    .bottom-nav { display: none; }

    @media (max-width: 1120px) {
      .hero-layout { grid-template-columns: 1fr 1fr; }
      .right-rail { grid-column: 1 / -1; grid-template-columns: 1fr 300px; }
      .color-grid { grid-template-columns: repeat(4, 1fr); }
      .card-grid { grid-template-columns: repeat(3, 1fr); }
      .shopping-row { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 860px) {
      .utility-date { display: none; }
      .header-main { grid-template-columns: 1fr auto; gap: 12px; padding: 12px 0; }
      .logo { font-size: 24px; }
      .logo-mark { width: 34px; height: 34px; }
      .search { grid-column: 1 / -1; order: 3; }
      .login-link { display: none; }
      .hero-layout, .right-rail, .content-with-ad, .feature-plus-list, .two-col, .footer-grid { grid-template-columns: 1fr; }
      .leaderboard-ad { display: none; }
      .mobile-ad { display: grid; }
      .square-ad { min-height: 220px; width: min(300px, 100%); justify-self: center; }
      .hero-card { min-height: auto; }
      .hero-art { min-height: 210px; }
      h1 { font-size: 30px; }
      .color-grid { grid-template-columns: repeat(4, minmax(112px, 1fr)); overflow-x: auto; padding-bottom: 4px; }
      .color-link { min-width: 112px; min-height: 104px; }
      .card-grid { grid-template-columns: repeat(2, 1fr); }
      .shopping-row { display: flex; overflow-x: auto; padding-bottom: 4px; }
      .shop-card { min-width: 160px; }
      .campaign-grid { grid-template-columns: 1fr; }
      .bottom-nav {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 80;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        background: #fff;
        border-top: 1px solid var(--line);
        box-shadow: 0 -8px 24px rgba(16, 24, 40, 0.08);
      }
      .bottom-nav a { padding: 9px 4px 8px; text-align: center; font-size: 11px; color: #475467; font-weight: 900; }
      .bottom-nav a.active { color: var(--green); }
    }

    @media (max-width: 520px) {
      .container { width: min(100% - 24px, var(--max)); }
      .btn { padding: 9px 12px; }
      .main-nav .container { gap: 18px; min-height: 42px; }
      .card-grid { grid-template-columns: 1fr; }
      .tool-grid { grid-template-columns: 1fr; }
      .story-row { grid-template-columns: 74px 1fr; }
      .member-stats { grid-template-columns: 1fr 1fr; }
      .module { padding: 16px; }
    }
  </style>
</head>
